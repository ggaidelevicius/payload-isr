{
  "name": "@ggaidelevicius/payload-isr",
  "version": "1.2.0",
  "description": "Payload CMS plugin for ISR-style path revalidation with optional full rebuild fallback",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && tsc --outDir dist --rootDir ./src && swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "next dev dev --turbo",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:payload generate:importmap",
    "generate:types": "pnpm dev:payload generate:types",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint",
    "lint:fix": "pnpm lint --fix",
    "test": "tsc --project dev/tsconfig.json && pnpm test:int",
    "test:int": "vitest run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test",
    "publish:check": "pnpm lint && pnpm test && pnpm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "copyfiles": "2.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.3.8",
    "graphql": "^17.0.2",
    "mongodb-memory-server": "11.3.0",
    "next": "16.3.8",
    "open": "^11.0.4",
    "payload": "3.90.2",
    "prettier": "^3.9.9",
    "qs-esm": "8.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "sharp": "0.35.5",
    "sort-package-json": "^4.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "payload": "^3.37.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "@payloadcms/eslint-config>typescript": "$typescript",
      "@typescript-eslint/eslint-plugin": "8.71.0",
      "@typescript-eslint/parser": "8.71.0",
      "@typescript-eslint/utils": "8.71.0",
      "typescript-eslint": "8.71.0"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "mongodb-memory-server",
      "sharp",
      "unrs-resolver"
    ]
  },
  "registry": "https://registry.npmjs.org/",
  "keywords": [
    "payload",
    "payloadcms",
    "plugin",
    "isr",
    "revalidation",
    "nextjs",
    "vercel"
  ],
  "author": "Gus Gaidelevicius",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggaidelevicius/payload-isr.git"
  },
  "bugs": {
    "url": "https://github.com/ggaidelevicius/payload-isr/issues"
  },
  "homepage": "https://github.com/ggaidelevicius/payload-isr#readme"
}
